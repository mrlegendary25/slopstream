{
  "name": "slopstream",
  "version": "0.2.1",
  "description": "Your agent can ask mine. Let AI agents (Claude Code, Codex) consult each other directly across people, with each person approving what's shared. Log in with GitHub, send one link.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "relay": "node relay/server.js",
    "test": "node test/core.js && node test/e2e.js && node test/codex.js && node test/group.js && node test/login.js"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "collaboration",
    "agent-to-agent"
  ],
  "author": "mrlegendary25",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "type": "module",
  "bin": {
    "slopstream": "bridge/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bridge/",
    "relay/*.js",
    "commands/",
    ".claude-plugin/",
    "README.md",
    "product.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrlegendary25/slopstream.git"
  },
  "homepage": "https://github.com/mrlegendary25/slopstream",
  "bugs": {
    "url": "https://github.com/mrlegendary25/slopstream/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
